{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S21",
  "skill_name": "change-management",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "hard",
  "description": "Validates change tracking and documentation is complete",
  "checks": [
    {
      "id": "change_document_exists",
      "type": "artifact_existence",
      "severity": "hard",
      "description": "At least one change document must exist",
      "artifacts": [
        "artifacts/Changes/*-CHG-*.md"
      ],
      "remediation": "Run change-management on the conversation or request that describes the change"
    },
    {
      "id": "structured_format",
      "type": "content_pattern",
      "severity": "hard",
      "description": "Change documents must carry a Change ID and an impact analysis",
      "file": "artifacts/Changes/*-CHG-*.md",
      "must_contain": [
        "**Change ID**",
        "## Impact Analysis"
      ],
      "remediation": "Follow the File Generation template in SKILL.md"
    },
    {
      "id": "change_id_format",
      "type": "content_pattern",
      "severity": "soft",
      "description": "Change IDs should follow {TYPE}-CHG-{###}",
      "file": "artifacts/Changes/*-CHG-*.md",
      "must_contain_pattern": "\\*\\*Change ID\\*\\*:\\s*[A-Z]+-CHG-\\d{3}",
      "remediation": "Use the ID pattern from Change ID Management, e.g. REQ-CHG-001"
    }
  ],
  "quality_score_weight": 0.09,
  "bypass_allowed": false,
  "workflow_archetypes": {
    "standard": "hard",
    "rapid": "soft",
    "compliance": "hard"
  }
}
