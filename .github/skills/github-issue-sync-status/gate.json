{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S29",
  "skill_name": "github-issue-sync-status",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates local task status has been synced from GitHub issue",
  "checks": [
    {
      "id": "issue_reference_recorded",
      "type": "content_pattern",
      "severity": "soft",
      "description": "Task files must be linked to issues before they can be synced",
      "file": "tasks/T*.md",
      "must_contain_pattern": "\\*\\*GitHub Issue:\\*\\*\\s*#?\\d+",
      "remediation": "Run github-issue-create-update first"
    },
    {
      "id": "status_field_present",
      "type": "content_pattern",
      "severity": "soft",
      "description": "Every task file should carry a status field the sync can update",
      "file": "tasks/T*.md",
      "must_contain_pattern": "\\*\\*(Status\\*\\*:|State:\\*\\*)",
      "remediation": "Use the task template's '**Status**:' field (or the older '**State:**')"
    }
  ],
  "quality_score_weight": 0.04,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
