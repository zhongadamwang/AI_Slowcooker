{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S05",
  "skill_name": "process-scopemin",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates minimum viable scope has been identified",
  "checks": [
    {
      "id": "scope_analysis_exists",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "Both scope analysis files should exist",
      "artifacts": [
        "artifacts/Analysis/scope-analysis.md",
        "artifacts/Analysis/scope-analysis.json"
      ],
      "remediation": "Run process-scopemin on requirements.json"
    },
    {
      "id": "core_vs_optional_classification",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The report should present core, enhancement, and optional features and the scope boundary",
      "file": "artifacts/Analysis/scope-analysis.md",
      "must_contain": [
        "## Core Features",
        "## Enhancement Features",
        "## Optional Features",
        "## Scope Boundaries"
      ],
      "remediation": "Follow the report template in references/output-format.md"
    },
    {
      "id": "roadmap_present",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The report should lay out a phased roadmap",
      "file": "artifacts/Analysis/scope-analysis.md",
      "must_contain": [
        "## MVP Roadmap"
      ],
      "remediation": "Add the '## MVP Roadmap' section"
    },
    {
      "id": "features_classified",
      "type": "json_schema",
      "severity": "soft",
      "description": "Every feature should have an ID, name, and category",
      "file": "artifacts/Analysis/scope-analysis.json",
      "json_path": "$.features[*]",
      "required_fields": [
        "id",
        "name",
        "category"
      ],
      "remediation": "Classify every feature as core, enhancement, or optional"
    },
    {
      "id": "categories_valid",
      "type": "content_pattern",
      "severity": "soft",
      "description": "Feature categories should be core, enhancement, or optional",
      "file": "artifacts/Analysis/scope-analysis.json",
      "json_path": "$.features[*].category",
      "must_contain_pattern": "^(core|enhancement|optional)$",
      "remediation": "Use exactly one of: core, enhancement, optional"
    }
  ],
  "quality_score_weight": 0.05,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "soft",
    "compliance": "bypass"
  }
}
