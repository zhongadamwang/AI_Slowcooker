{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S19",
  "skill_name": "project-planning-tracking",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates project planning and tracking structures are established",
  "checks": [
    {
      "id": "planning_documents_exist",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "The project plan and tracking document should exist",
      "artifacts": [
        "project-plan.md",
        "tasks/task-tracking.md"
      ],
      "remediation": "Run project-planning-tracking after the plan-* skills"
    },
    {
      "id": "plan_structure",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The plan should state phases, schedule, and risks",
      "file": "project-plan.md",
      "must_contain": [
        "## Project Phases",
        "## Schedule and Capacity",
        "## Risk Management"
      ],
      "remediation": "Follow the project-plan.md template"
    },
    {
      "id": "tracking_has_task_list",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The tracking document should list every task with its status",
      "file": "tasks/task-tracking.md",
      "must_contain": [
        "## Task List",
        "**Last Updated**"
      ],
      "remediation": "Write the '## Task List' table with one row per task"
    }
  ],
  "quality_score_weight": 0.05,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
