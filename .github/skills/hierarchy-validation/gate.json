{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S12",
  "skill_name": "hierarchy-validation",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "hard",
  "description": "Validates structural integrity of process hierarchy",
  "checks": [
    {
      "id": "validation_report_exists",
      "type": "artifact_existence",
      "severity": "hard",
      "description": "Both hierarchy validation reports must exist",
      "artifacts": [
        "artifacts/Testing/hierarchy-validation-report.md",
        "artifacts/Testing/hierarchy-validation-report.json"
      ],
      "remediation": "Run hierarchy-validation on the process hierarchy"
    },
    {
      "id": "no_error_violations",
      "type": "json_query",
      "severity": "hard",
      "description": "No error-severity rule may have failed",
      "file": "artifacts/Testing/hierarchy-validation-report.json",
      "json_path": "$.summary.failed_errors",
      "max_value": 0,
      "remediation": "Fix each failed ERROR rule listed in rule_results, then re-run hierarchy-validation"
    },
    {
      "id": "overall_status_valid",
      "type": "content_pattern",
      "severity": "hard",
      "description": "The overall status must be VALID or MOSTLY_VALID",
      "file": "artifacts/Testing/hierarchy-validation-report.json",
      "json_path": "$.summary.overall_status",
      "must_contain_pattern": "^(VALID|MOSTLY_VALID)$",
      "remediation": "Resolve the reported violations until overall_status is VALID or MOSTLY_VALID"
    },
    {
      "id": "rule_results_recorded",
      "type": "json_schema",
      "severity": "hard",
      "description": "The report must carry per-rule results",
      "file": "artifacts/Testing/hierarchy-validation-report.json",
      "required_fields": [
        "summary",
        "rule_results"
      ],
      "non_empty_fields": [
        "rule_results"
      ],
      "remediation": "Write rule_results with one entry per rule checked"
    },
    {
      "id": "warning_count_acceptable",
      "type": "json_query",
      "severity": "soft",
      "description": "Warning-level failures should stay low",
      "file": "artifacts/Testing/hierarchy-validation-report.json",
      "json_path": "$.summary.failed_warnings",
      "max_value": 5,
      "remediation": "Review and address the warning-level violations"
    }
  ],
  "quality_score_weight": 0.15,
  "bypass_allowed": false,
  "workflow_archetypes": {
    "standard": "hard",
    "rapid": "soft",
    "compliance": "hard"
  }
}
