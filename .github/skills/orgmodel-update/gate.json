{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S26",
  "skill_name": "orgmodel-update",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates organizational model updates have been applied",
  "checks": [
    {
      "id": "update_summary_exists",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "The update summary should record what was changed",
      "artifacts": [
        "artifacts/Analysis/orgmodel-update-summary.md"
      ],
      "remediation": "Write orgmodel-update-summary.md listing each document changed and the plan items applied"
    },
    {
      "id": "changes_recorded",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The summary should list the changes applied",
      "file": "artifacts/Analysis/orgmodel-update-summary.md",
      "must_contain": [
        "## Changes Applied"
      ],
      "remediation": "Add the '## Changes Applied' section"
    }
  ],
  "quality_score_weight": 0.05,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "hard"
  }
}
