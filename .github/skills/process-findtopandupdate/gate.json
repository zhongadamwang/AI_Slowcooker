{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S24",
  "skill_name": "process-findtopandupdate",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates top-level requirements have been identified and updated",
  "checks": [
    {
      "id": "updated_requirements_exist",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "The top-requirements proposal and orgModel update plan should exist",
      "artifacts": [
        "artifacts/Analysis/top-requirements-update.md",
        "artifacts/Analysis/top-requirements-update.json",
        "artifacts/Analysis/orgmodel-update-plan.md"
      ],
      "remediation": "Run process-findtopandupdate"
    },
    {
      "id": "proposal_structure",
      "type": "json_schema",
      "severity": "soft",
      "description": "The proposal should carry the hierarchy analysis and orgModel coordination",
      "file": "artifacts/Analysis/top-requirements-update.json",
      "required_fields": [
        "hierarchy_analysis",
        "orgmodel_coordination"
      ],
      "remediation": "Write hierarchy_analysis and orgmodel_coordination per references/output-format.md"
    },
    {
      "id": "report_sections",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The report should list the proposed requirement updates and the affected orgModel documents",
      "file": "artifacts/Analysis/top-requirements-update.md",
      "must_contain": [
        "## Updated Requirements",
        "## OrgModel Coordination"
      ],
      "remediation": "Follow the report layout in SKILL.md"
    }
  ],
  "quality_score_weight": 0.06,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
