{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S28",
  "skill_name": "github-issue-create-update",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates GitHub issue has been created or updated from task markdown",
  "checks": [
    {
      "id": "task_files_exist",
      "type": "file_count",
      "severity": "soft",
      "description": "The project should have task files to publish",
      "pattern": "tasks/T*.md",
      "min_count": 1,
      "remediation": "Run plan-derivetasks first"
    },
    {
      "id": "issue_reference_recorded",
      "type": "content_pattern",
      "severity": "soft",
      "description": "Every task file should link to its GitHub Issue",
      "file": "tasks/T*.md",
      "must_contain_pattern": "\\*\\*GitHub Issue:\\*\\*\\s*#?\\d+",
      "remediation": "Run create_update_issues.py --project for the project; it writes '**GitHub Issue:** #N' into each task file it publishes"
    }
  ],
  "quality_score_weight": 0.04,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
