        "\\b(validate.*everything|check.*all|full.*validation|comprehensive.*check)\\b",
        "\\b(validate.*hierarchy.*compliance|compliance.*check.*all)\\b"
      ],
      "matched_workflows": ["comprehensive_validation_workflow"]
    },
    "documentation_focus": {
      "patterns": [
        "\\b(generate.*all.*doc|auto.?generate.*doc|documentation.*all.*level|document.*hierarch)\\b"
      ],
      "matched_workflows": ["documentation_generation_workflow"]
    },
    "quick_analysis": {
      "patterns": [
        "\\b(quick.*look|fast.*analysis|brief.*review|short.*check|just.*review)\\b"
      ],
      "matched_workflows": ["quick_analysis_workflow"]
    }
  },

  "contextual_adaptors": {
    "project_phase_adaptations": {
      "early_phase": {
        "boost_skills": ["requirements-ingest", "goals-extract", "process-w5h", "domain-extractconcepts"],
        "suppress_skills": ["change-management", "plant-buildschedule"],
        "quality_default": "standard"
      },
      "design_phase": {
        "boost_skills": ["diagram-generatecollaboration", "domain-alignentities", "hierarchy-management"],
        "suppress_skills": [],
        "quality_default": "high"
      },
      "implementation_phase": {
        "boost_skills": ["hierarchy-validation", "edps-compliance", "edps-quality-gates"],
        "suppress_skills": ["process-w5h", "goals-extract"],
        "quality_default": "standard"
      },
      "completion_phase": {
        "boost_skills": ["documentation-automation", "project-status-reporting", "edps-compliance"],
        "suppress_skills": ["requirements-ingest"],
        "quality_default": "high"
      }
    },
    "quality_level_adaptations": {
      "high": {
        "recommended_gates": ["content_completeness_gate", "format_validation_gate", "quality_scoring_gate", "vr1_boundary_compliance_gate", "quality_threshold_gate"],
        "workflow_modifiers": ["add_validation_steps", "add_documentation_steps"],
        "default_timeout": 60000
      },
      "standard": {
        "recommended_gates": ["content_completeness_gate", "format_validation_gate", "quality_scoring_gate"],
        "workflow_modifiers": [],
        "default_timeout": 30000
      },
      "expedited": {
        "recommended_gates": ["content_completeness_gate"],
        "workflow_modifiers": ["skip_optional_steps", "parallel_where_possible"],
        "default_timeout": 15000
      }
    },
    "urgency_adaptations": {
      "high": {
        "workflow_optimizations": ["maximum_parallelism", "skip_optional_quality_gates", "fast_path_preferred"],
        "max_clarification_questions": 1,
        "confidence_threshold": 0.65
      },
      "medium": {
        "workflow_optimizations": ["moderate_parallelism"],
        "max_clarification_questions": 2,
        "confidence_threshold": 0.75
      },
      "low": {
        "workflow_optimizations": ["thorough_validation", "include_all_quality_gates"],
        "max_clarification_questions": 3,
        "confidence_threshold": 0.85
      }
    }
  },

  "clarification_templates": {
    "intent_ambiguity": {
      "multi_intent": "Your request could mean several things. Are you looking to:\n{options}\nWhich best describes what you need?",
      "unclear_action": "What action would you like to take? (create / validate / update / analyze / document)",
      "unclear_target": "What are you working with? Please specify the artifact, document, or project component."
    },
    "missing_entities": {
      "missing_project_context": "Which project or process should I focus on?",
      "missing_quality_requirements": "What quality level do you need? (comprehensive / standard / quick)",
      "missing_scope": "What's the scope? (single step / selected skills / full workflow)",
      "missing_starting_point": "What do you have to start with? (requirements doc / existing model / new project)"
    },
    "workflow_clarification": {
      "multiple_workflows": "I found {count} workflow options that might work. Which best fits your goal?\n{workflow_descriptions}",
      "custom_or_standard": "Do you want to use a standard EDPS workflow, or would you like a customized workflow for your specific needs?"
    }
  },

  "confidence_thresholds": {
    "skip_clarification": 0.85,
    "show_top_recommendation_only": 0.90,
    "require_single_clarification": 0.70,
    "require_multiple_clarifications": 0.55,
    "minimum_actionable": 0.40
  },

  "learning_configuration": {
    "feedback_collection": {
      "collect_acceptance_rejection": true,
      "collect_rejection_reason": true,
      "collect_correction_input": true
    },
    "model_update": {
      "immediate_update_threshold": 0.8,
      "batch_update_size": 10,
      "pattern_boost_rate": 0.05,
      "pattern_reduction_rate": 0.03
    },
    "performance_tracking": {
      "track_intent_accuracy": true,
      "track_recommendation_acceptance": true,
      "track_workflow_success": true,
      "accuracy_reporting_interval": 50
    }
  }
}
