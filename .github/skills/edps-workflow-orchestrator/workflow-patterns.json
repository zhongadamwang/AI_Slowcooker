              "depth_focused": {
                "impact": "increase_analysis_time",
                "parameters": {"analysis_mode": "deep_dive"}
              },
              "breadth_focused": {
                "impact": "reduce_detail_level",  
                "parameters": {"analysis_mode": "broad_survey"}
              }
            }
          },
          {
            "after_step": 5,
            "decision": "validation_thoroughness",
