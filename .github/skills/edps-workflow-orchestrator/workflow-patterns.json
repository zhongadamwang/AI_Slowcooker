            "options": {
              "comprehensive": {
                "impact": "increase_validation_time",
                "parameters": {"validation_level": "exhaustive"}
              },
              "targeted": {
                "impact": "focus_critical_areas",
                "parameters": {"validation_level": "risk_based"}
              }
            }
          }
