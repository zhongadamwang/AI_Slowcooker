{
  "workflow_patterns": {
    "fast_track": {
      "requirements_quick_analysis": {
        "id": "req_quick_001",
        "name": "Quick Requirements Analysis",
        "description": "Fast-track analysis for simple, well-defined requirements",
        "execution_time": "30-45 minutes",
        "complexity": "low",
        "success_rate": 0.92,
        "steps": [
          {
            "order": 1,
            "skill_id": "requirements-ingest",
            "execution_pattern": "sequential",
            "timeout": 600,
            "parameters": {
              "validation_level": "basic",
              "output_format": "structured"
            },
            "success_criteria": ["valid_format", "basic_completeness"]
          },
          {
            "order": 2,
            "skill_id": "goals-extract",
            "execution_pattern": "sequential",
            "timeout": 900,
            "parameters": {
              "depth": "shallow",
              "focus": "primary_objectives"
            },
            "success_criteria": ["goals_identified", "success_criteria_defined"]
          },
          {
            "order": 3,
            "skill_id": "process-w5h",
            "execution_pattern": "sequential",
            "timeout": 1200,
            "parameters": {
              "analysis_depth": "standard",
              "focus_questions": ["what", "who", "when"]
            },
            "success_criteria": ["w5h_analysis_complete", "insights_generated"]
          }
        ],
        "quality_gates": [
          {
            "gate_id": "requirements_basic_validation",
            "after_step": 1,
            "validation_rules": ["format_check", "completeness_check"],
            "failure_action": "retry_with_guidance"
          }
        ],
        "optimization_hints": {
          "skip_advanced_validation": true,
          "use_template_acceleration": true,
          "minimal_documentation": true,
          "cache_intermediate_results": true
        },
        "conditions": {
          "requirements_complexity": ["simple", "well_defined"],
          "urgency_level": ["high"],
          "quality_expectations": ["standard"],
          "available_time": ["< 1 hour"]
        }
      },
      
      "domain_discovery_rapid": {
        "id": "dom_rapid_001",
        "name": "Rapid Domain Discovery",
        "description": "Quick domain concept extraction with parallel processing",
        "execution_time": "45-60 minutes", 
        "complexity": "medium",
        "success_rate": 0.88,
        "steps": [
          {
            "order": 1,
            "skill_id": "requirements-ingest",
            "execution_pattern": "parallel_group_a",
            "timeout": 600,
            "parameters": {
              "validation_level": "standard",
              "focus": "domain_elements"
            },
            "success_criteria": ["requirements_parsed", "domain_context_available"]
          },
          {
            "order": 1,
            "skill_id": "goals-extract", 
            "execution_pattern": "parallel_group_a",
            "timeout": 900,
            "parameters": {
              "depth": "moderate",
              "domain_focus": true
            },
            "success_criteria": ["business_goals_extracted", "domain_objectives_clear"]
          },
          {
            "order": 2,
            "skill_id": "domain-extractconcepts",
            "execution_pattern": "sequential_convergence",
            "timeout": 1800,
            "parameters": {
              "analysis_mode": "comprehensive",
              "input_sources": ["requirements", "goals"]
            },
            "success_criteria": ["domain_model_generated", "concepts_categorized"],
            "dependencies": ["parallel_group_a"]
          }
        ],
        "parallel_execution_groups": {
          "parallel_group_a": {
            "skills": ["requirements-ingest", "goals-extract"],
            "coordination_strategy": "wait_for_all",
            "timeout": 1200,
            "failure_policy": "continue_with_available"
          }
        },
        "quality_gates": [
          {
            "gate_id": "domain_consistency_check",
            "after_step": 2,
            "validation_rules": ["concept_coherence", "terminology_consistency"],
            "failure_action": "refine_and_retry"
          }
        ]
      }
    },

