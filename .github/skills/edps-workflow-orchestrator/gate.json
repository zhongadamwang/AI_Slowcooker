{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S31",
  "skill_name": "edps-workflow-orchestrator",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "hard",
  "description": "Validates workflow orchestration has been properly configured and executed",
  "checks": [
    {
      "id": "workflow_state_exists",
      "type": "artifact_existence",
      "severity": "hard",
      "description": "The project state file must exist",
      "artifacts": [
        "project-state.json"
      ],
      "remediation": "Run 'orchestrate start' to create project-state.json"
    },
    {
      "id": "state_structure",
      "type": "json_schema",
      "severity": "hard",
      "description": "The state must record the archetype and the skill states",
      "file": "project-state.json",
      "required_fields": [
        "project_id",
        "archetype",
        "skills"
      ],
      "non_empty_fields": [
        "skills"
      ],
      "remediation": "Write project-state.json per the Project State Schema"
    },
    {
      "id": "archetype_valid",
      "type": "content_pattern",
      "severity": "hard",
      "description": "The archetype must be standard, rapid, or compliance",
      "file": "project-state.json",
      "json_path": "$.archetype",
      "must_contain_pattern": "^(standard|rapid|compliance)$",
      "remediation": "Set archetype to one of the three named archetypes"
    },
    {
      "id": "history_recorded",
      "type": "json_schema",
      "severity": "soft",
      "description": "The state should keep a history of workflow events",
      "file": "project-state.json",
      "required_fields": [
        "history"
      ],
      "non_empty_fields": [
        "history"
      ],
      "remediation": "Append an entry to history after every step"
    }
  ],
  "quality_score_weight": 0.15,
  "bypass_allowed": false,
  "workflow_archetypes": {
    "standard": "hard",
    "rapid": "hard",
    "compliance": "hard"
  }
}
