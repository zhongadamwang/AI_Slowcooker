{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S07",
  "skill_name": "domain-alignentities",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates domain concepts have been aligned with organizational standards",
  "checks": [
    {
      "id": "alignment_analysis_exists",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "Both alignment files should exist",
      "artifacts": [
        "artifacts/Analysis/domain-alignment.md",
        "artifacts/Analysis/domain-alignment.json"
      ],
      "remediation": "Run domain-alignentities on domain-concepts.json"
    },
    {
      "id": "alignment_structure",
      "type": "json_schema",
      "severity": "soft",
      "description": "The alignment data should carry entity alignments and detected conflicts",
      "file": "artifacts/Analysis/domain-alignment.json",
      "required_fields": [
        "entity_alignments",
        "conflicts_detected"
      ],
      "remediation": "Write entity_alignments and conflicts_detected (empty when none were found)"
    },
    {
      "id": "mapping_documentation",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The report should document alignments, conflicts, and recommendations",
      "file": "artifacts/Analysis/domain-alignment.md",
      "must_contain": [
        "## Entity Alignments",
        "## Conflicts & Resolutions",
        "## Recommendations"
      ],
      "remediation": "Follow the report template in references/output-format.md"
    }
  ],
  "quality_score_weight": 0.05,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
