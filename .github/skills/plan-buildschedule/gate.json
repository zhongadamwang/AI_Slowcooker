{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S17",
  "skill_name": "plan-buildschedule",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates project schedule has been built with dependencies and milestones",
  "checks": [
    {
      "id": "schedule_exists",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "The schedule files should exist",
      "artifacts": [
        "artifacts/Analysis/project-schedule.json",
        "artifacts/Analysis/project-schedule.md",
        "artifacts/Analysis/critical-path-analysis.md"
      ],
      "remediation": "Run plan-buildschedule on task-breakdown.json and effort-estimates.json"
    },
    {
      "id": "gantt_representation",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The schedule should include a Mermaid Gantt chart",
      "file": "artifacts/Analysis/project-schedule.md",
      "must_contain": [
        "```mermaid",
        "gantt"
      ],
      "remediation": "Render the schedule as a mermaid gantt block"
    },
    {
      "id": "critical_path_recorded",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The schedule should name its critical path",
      "file": "artifacts/Analysis/project-schedule.md",
      "must_contain_pattern": "(?i)critical path",
      "remediation": "Record the critical path from the forward and backward pass"
    }
  ],
  "quality_score_weight": 0.06,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
