{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S20",
  "skill_name": "project-status-reporting",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates comprehensive project status reports are generated",
  "checks": [
    {
      "id": "status_report_exists",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "A status report should exist",
      "artifacts": [
        "artifacts/Analysis/status-report-*.md"
      ],
      "remediation": "Run project-status-reporting; it writes artifacts/Analysis/status-report-[YYYY-MM-DD].md"
    },
    {
      "id": "report_dated_and_typed",
      "type": "content_pattern",
      "severity": "soft",
      "description": "Each report should state its type and the date its data was read",
      "file": "artifacts/Analysis/status-report-*.md",
      "must_contain": [
        "**Report Type**",
        "**Data As Of**"
      ],
      "remediation": "Add the Report Type and Data As Of lines at the top of the report"
    }
  ],
  "quality_score_weight": 0.04,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
