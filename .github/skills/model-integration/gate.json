{
  "$schema": "https://edps.dev/schemas/gate/v1.0.0",
  "skill_id": "S25",
  "skill_name": "model-integration",
  "version": "1.0.0",
  "gate_type": "completion",
  "severity": "soft",
  "description": "Validates systematic integration of domain models",
  "checks": [
    {
      "id": "integration_plan_exists",
      "type": "artifact_existence",
      "severity": "soft",
      "description": "The model integration plan should exist",
      "artifacts": [
        "artifacts/Analysis/model-integration.md",
        "artifacts/Analysis/model-integration.json"
      ],
      "remediation": "Run model-integration on the project's domain alignment"
    },
    {
      "id": "integration_structure",
      "type": "json_schema",
      "severity": "soft",
      "description": "The integration data should carry the integration plan",
      "file": "artifacts/Analysis/model-integration.json",
      "required_fields": [
        "integration_plan"
      ],
      "remediation": "Write integration_plan per references/output-format.md"
    },
    {
      "id": "report_sections",
      "type": "content_pattern",
      "severity": "soft",
      "description": "The report should state the integration strategy",
      "file": "artifacts/Analysis/model-integration.md",
      "must_contain": [
        "## Integration Strategy"
      ],
      "remediation": "Follow the report template in references/output-format.md"
    }
  ],
  "quality_score_weight": 0.07,
  "bypass_allowed": true,
  "workflow_archetypes": {
    "standard": "soft",
    "rapid": "bypass",
    "compliance": "soft"
  }
}
